# Copy this file to .env.local and fill in the real values.
# .env.local is git-ignored and must never be committed or shared in an archive.

# MongoDB Atlas connection string, including the database name before the "?".
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/vulpian_cms?appName=vulpian

# Bootstrap admin sign-in. Once credentials are changed from the admin's
# "Login details" screen they are stored (hashed) in the database and these
# values are no longer used to sign in.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password

# Signs admin sessions. Any long random string. Kept separate from the admin
# password so that changing the password does not sign everyone out.
AUTH_SECRET=generate-a-long-random-string

# The site's public address. Canonical URLs, link-preview images and the
# sitemap are all built from this, so it must match the live domain.
NEXT_PUBLIC_SITE_URL=https://www.vulpianco.com
